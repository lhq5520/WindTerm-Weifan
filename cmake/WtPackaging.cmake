# CPack configuration: TGZ/DEB on Linux, DragNDrop (DMG) on macOS, ZIP/NSIS on Windows.
# Platform scripts in tools/package/ add deployment (Qt plugins), signing and notarization.

set(CPACK_PACKAGE_NAME "WindTerm-Weifan")
set(CPACK_PACKAGE_VENDOR "WindTerm-Weifan")
set(CPACK_PACKAGE_CONTACT "WindTerm-Weifan maintainers")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Cross-platform terminal emulator and SSH/SFTP client")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_INSTALL_DIRECTORY "WindTerm-Weifan")
set(CPACK_PACKAGE_EXECUTABLES "WindTerm-Weifan;WindTerm-Weifan")
set(CPACK_STRIP_FILES ON)
set(CPACK_PACKAGE_FILE_NAME
    "${CPACK_PACKAGE_NAME}-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    string(REPLACE ";" "-" _wt_archs "${CMAKE_OSX_ARCHITECTURES}")
    set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${PROJECT_VERSION}-macOS-${_wt_archs}")
endif()

if(APPLE)
    set(CPACK_GENERATOR "DragNDrop")
    set(CPACK_DMG_VOLUME_NAME "WindTerm-Weifan")
    set(CPACK_DMG_FORMAT "UDZO")
elseif(WIN32)
    set(CPACK_GENERATOR "ZIP")
    find_program(WT_MAKENSIS makensis)
    if(WT_MAKENSIS)
        list(APPEND CPACK_GENERATOR "NSIS")
    endif()
    set(CPACK_NSIS_DISPLAY_NAME "WindTerm-Weifan")
    set(CPACK_NSIS_MUI_ICON "${PROJECT_SOURCE_DIR}/app/resources/icons/windterm-weifan.ico")
    set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\\\WindTerm-Weifan.exe")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
else()
    set(CPACK_GENERATOR "TGZ")
    find_program(WT_DPKG dpkg)
    if(WT_DPKG)
        list(APPEND CPACK_GENERATOR "DEB")
    endif()
    set(CPACK_DEBIAN_PACKAGE_SECTION "x11")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    # Distribution package names (Debian 13 / Ubuntu 24.10+); adjust for other targets.
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "libqt6widgets6 (>= 6.5), libssh2-1, libsodium23 | libssl3")
endif()

include(CPack)
