{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug (app + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (app + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "core-only",
      "displayName": "Qt-free libraries + tests (no Qt required)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WT_BUILD_APP": "OFF" }
    },
    {
      "name": "sodium",
      "displayName": "Debug, credential vault on libsodium (distributions with OpenSSL < 3.2)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WT_CRYPTO_BACKEND": "sodium" }
    },
    {
      "name": "asan",
      "displayName": "Debug with ASan/UBSan",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WT_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon (arm64)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal2 (arm64 + x86_64, needs universal Qt/libssh2/OpenSSL)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64, MSVC + vcpkg (libssh2, OpenSSL)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-mingw-cross",
      "displayName": "Windows x64 cross-compile check with mingw-w64 (libraries + tests, from Linux/macOS)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WT_BUILD_APP": "OFF",
        "WT_ENABLE_SSH": "OFF",
        "WT_ENABLE_VAULT": "OFF",
        "WT_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "core-only", "configurePreset": "core-only" },
    { "name": "sodium", "configurePreset": "sodium" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-universal", "configurePreset": "macos-universal" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "windows-mingw-cross", "configurePreset": "windows-mingw-cross" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "core-only", "inherits": "base", "configurePreset": "core-only" },
    { "name": "sodium", "inherits": "base", "configurePreset": "sodium" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "macos-arm64", "inherits": "base", "configurePreset": "macos-arm64" },
    { "name": "macos-universal", "inherits": "base", "configurePreset": "macos-universal" },
    { "name": "windows-msvc", "inherits": "base", "configurePreset": "windows-msvc" }
  ]
}
